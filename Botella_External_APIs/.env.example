ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=false

# Shared secret for the work endpoints and the whole /storeagent surface (sent
# as `X-API-Key`). REQUIRED WHEN ENVIRONMENT=production: the service refuses to
# start without it, naming this variable (app/config.py), the way Node refuses
# without NODE_API_TOKEN. Unset outside production = open, and the startup log
# says so once - anyone who reaches the port can burn LLM spend and read any
# store's figures. Generate: openssl rand -hex 32. The SAME value goes in
# backend/.env twice, as REC_SERVICE_API_KEY and STOREAGENT_API_KEY (Node is
# the client that sends the header).
SERVICE_API_KEY=

# CORS is off by default (machine-to-machine service). To enable for a browser
# client, set a JSON list, e.g. CORS_ALLOW_ORIGINS=["http://localhost:5173"]
#CORS_ALLOW_ORIGINS=

# Where this service calls BACK into the Node backend. It must be reachable
# FROM WHEREVER THIS SERVICE RUNS, which is not the same place the backend runs.
#
#   bare metal / venv     -> http://localhost:3000
#   inside a container    -> http://host.docker.internal:3000
#
# `localhost` and `127.0.0.1` mean THIS CONTAINER when this service is
# containerised, so they resolve, refuse the connection, and surface as
# `node_api_error` after the run has already done all its work. Observed on QA
# 29 September 2026: docker-compose.yml already defaults this correctly, but a
# `.env` copied from this file overrides that default and reintroduces it.
NODE_API_BASE_URL=http://localhost:3000
# Bearer token sent as `Authorization: Bearer <token>` on every call to Node.
#
# NOT OPTIONAL any more, and it was never really optional: Node now requires the
# same value in production and refuses to start without it, so an empty value
# here means every call gets a 401 from a server that is running correctly.
# It must MATCH NODE_API_TOKEN in backend/.env exactly.
#
# Generate once:  openssl rand -hex 32
NODE_API_TOKEN=
NODE_API_TIMEOUT_SECONDS=15
NODE_API_MAX_RETRIES=3
# 365 is load-bearing, not a generous default: the engine blends a 28-day
# window against the SKU's own long run, so a shorter window leaves the long
# run barely longer than the recent one and the reversion signal flattens.
# It degrades quietly - recommendations still appear, they are just worse.
NODE_SALES_WINDOW_DAYS=365

ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6
# Must fit the full tool JSON for all recommendations + any effort/thinking
# tokens (they share this budget). Too low truncates the tool call.
LLM_MAX_TOKENS=8192
LLM_EFFORT=medium
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
# Caches the static prefix (tools + system prompt) so it is written once and
# reused by the other stores in the SAME run. A cache write costs 1.25x base
# input and a read 0.1x, and the entry lives ~5 minutes, so it only pays off
# when 2+ stores go through one bulk run inside that window. Running a single
# store (or stores spread hours apart) writes an entry nothing ever reads:
# pure premium, no benefit — set false until the network is bulk-running
# several stores at once. Verify either way via the cache_read / cache_write
# fields in the llm_call_complete log line.
# Note: the prefix only caches at all when it is >= ~2,048 tokens on Sonnet 4.6.
PROMPT_CACHE_ENABLED=true

# Bulk endpoint (POST /run-recommendations) + Message Batches API.
BULK_MAX_CONCURRENCY=8
BULK_MAX_PAIRS=500
# "batch" mode submits one Anthropic Message Batch (~50% LLM cost) and polls
# until it ends or this cap is reached. For long batches prefer the
# non-blocking POST /run-recommendations/batch + .../collect endpoints.
BATCH_POLL_INTERVAL_SECONDS=10
BATCH_MAX_WAIT_SECONDS=1800

CANDIDATE_POOL_SIZE=150
TARGET_MIN_RECOMMENDATIONS=8
MAX_RECOMMENDATIONS=10
RECOMMENDATION_FLOOR=5
# Small-format ("nip") ceiling in millilitres. Bottles at or under this are
# never recommended and never reach the StoreAgent buy list: pocket-priced
# minis rack up unit counts that no real bottle can match, so unit-ranked
# lists filled with the nip rack. 50 excludes 50ml only; 100 also excludes
# 100ml minis; 0 disables the exclusion.
SMALL_FORMAT_MAX_ML=50
# Trailing window of past recommendations fetched from Node (optional
# endpoint) for the feedback loop; inert until Node serves it.
FEEDBACK_WINDOW_DAYS=30
# Cap on history rows used per run (sent to Node as ?limit= and re-enforced in
# Python: voted recs kept first, then most-recent). Bounds the feedback digest.
RECOMMENDATION_HISTORY_LIMIT=20
# Recommendation scoring: blend of realized lift vs explicit thumbs votes
# (renormalized when one is missing), and the thresholds that promote a rec's
# SKUs to the "proven" candidate slice or demote them to the avoid-list.
FEEDBACK_LIFT_WEIGHT=0.6
FEEDBACK_USER_WEIGHT=0.4
FEEDBACK_WINNER_THRESHOLD=0.6
FEEDBACK_LOSER_THRESHOLD=0.4

GEOCODING_ENABLED=true

# Shared geo-keyed signal cache (weather/sports/events/holidays/news reused
# across stores in the same area within a run). TTL outlives a run, expires
# within a day. Set SIGNAL_CACHE_ENABLED=false to disable.
SIGNAL_CACHE_ENABLED=true
SIGNAL_CACHE_TTL_SECONDS=21600

HTTP_TIMEOUT_SECONDS=10
NWS_USER_AGENT=ContextualIntelligenceService/1.0 (you@example.com)
TICKETMASTER_API_KEY=
NEWSDATA_API_KEY=
# LLM news analyst: one small Haiku call per state per signal-cache TTL reads
# the fetched headlines and emits impact/categories/product keywords — so news
# the keyword list never anticipated still drives recommendations. Fail-soft;
# set false to fall back to keyword matching only.
NEWS_LLM_ENABLED=true
NEWS_LLM_MODEL=claude-haiku-4-5
NEWS_LLM_MAX_TOKENS=2048
# Max analyst-kept state news carried into the bundle (keeps prompt lines,
# ACTIVE KEYS, and the snapshot in agreement; email items are capped at 3
# separately, so news tops out at 8 lines).
NEWS_MAX_KEPT=5
# LLM event analyst: one small Haiku call per store area per signal-cache TTL
# screens the raw Ticketmaster feed, keeping only events that plausibly move
# liquor demand and adding crowd draw, affected categories, a citable key, and
# a one-line note per event. Fail-soft; set false to fall back to the
# segment-keyword mapping (every nearby event kept, name + date only).
EVENTS_LLM_ENABLED=true
EVENTS_LLM_MODEL=claude-haiku-4-5
EVENTS_LLM_MAX_TOKENS=4096
# Max events kept in the prompt/snapshot (biggest draws first when analyzed).
EVENTS_MAX_KEPT=5
# Total signal chips (weather + sports + events + holidays + news + trends)
# kept in the owner-facing snapshot, trimmed by priority (weather, holidays,
# major events, games, impact news, social trends, lesser events, soft news).
# The LLM prompt always sees the full bundle; this only bounds what the UI
# shows.
SIGNAL_DISPLAY_CAP=10

# Social trend signals: Reddit discovers what's trending (official OAuth API,
# one global fetch per signal-cache TTL serves the whole network), Google
# Trends quantifies search momentum per state. Master switch for the channel:
SOCIAL_TRENDS_ENABLED=true
# Reddit script-app credentials (https://www.reddit.com/prefs/apps, type
# "script"). Leave blank to keep the Reddit source dormant. The free tier
# allows 100 requests/minute; this service makes two per cache TTL.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Reddit requires a descriptive User-Agent and throttles library defaults.
REDDIT_USER_AGENT=server:botella-contextual-intelligence:v1.0
# Subreddits pulled as one multireddit listing (r/a+b+c/top?t=week), JSON list:
# REDDIT_SUBREDDITS=["cocktails","bourbon","whiskey","wine","beer","Tequila","rum","Mixology","alcohol"]
# Posts pulled per fetch and the upvote floor below which a post is noise.
REDDIT_TOP_LIMIT=40
REDDIT_MIN_SCORE=25
# YouTube discovery: official Data API v3, needs only an API key (Google
# Cloud Console -> enable "YouTube Data API v3" -> Credentials -> API key).
# Feeds the same discovery channel as Reddit with this week's most-viewed
# drink videos. Leave blank to keep the source dormant. Each search query
# costs 100 quota units of the free 10k/day, so keep the list short.
YOUTUBE_API_KEY=
# YOUTUBE_QUERIES=["cocktail trend","trending drink","cocktail recipe"]
YOUTUBE_MIN_VIEWS=10000
YOUTUBE_MAX_VIDEOS=40
# LLM trend analyst: one Haiku call per cache TTL extracts trending drink
# terms from the raw post and video titles (terms the keyword floor's
# vocabulary never anticipated). Fail-soft; the keyword floor is the fallback.
TREND_LLM_ENABLED=true
TREND_LLM_MODEL=claude-haiku-4-5
TREND_LLM_MAX_TOKENS=2048
# Max trend terms carried into the prompt and snapshot.
TREND_MAX_KEPT=5
# Google Trends rides an UNOFFICIAL endpoint (there is no public API) and can
# get rate limited or break without notice, so it ships OFF. Probe it from
# the deploy host first (python probe_external_apis.py); every error degrades
# to Reddit-only.
GOOGLE_TRENDS_ENABLED=false
# Seed terms measured per state, JSON list (defaults are a curated drinks set):
# GOOGLE_TRENDS_SEED_TERMS=["espresso martini","aperol spritz","high noon"]
GOOGLE_TRENDS_TIMEFRAME=today 3-m
# Pause between term batches; the endpoint 429s rapid-fire requests.
GOOGLE_TRENDS_BATCH_PAUSE_SECONDS=5
# Rising = trailing-week interest >= baseline * threshold AND >= the floor.
GOOGLE_TRENDS_RISING_THRESHOLD=1.25
GOOGLE_TRENDS_MIN_INTEREST=10

# Daily industry email as a news signal, pulled over IMAP. GoDaddy
# Professional Email is powered by Titan Mail; its IMAP endpoint is
# imap.titan.email:993 (SSL). Leave user/password blank to keep this source
# dormant. Store-independent: one mailbox read per signal-cache TTL.
EMAIL_SIGNAL_ENABLED=true
EMAIL_IMAP_HOST=imap.titan.email
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USER=
EMAIL_IMAP_PASSWORD=
EMAIL_IMAP_MAILBOX=INBOX
# Spam folders checked when the primary mailbox has no fresh issue (JSON
# list; the server's own \Junk folder is tried first, nonexistent names are
# skipped). "Bulk Mail" is GoDaddy Workspace's spam folder.
EMAIL_SPAM_MAILBOXES=["Bulk Mail", "Spam", "Junk", "Junk E-mail"]
# Senders whose messages are ingested (JSON list).
EMAIL_SENDERS=["mbrown@sazerac.com"]
# Coarse server-side SINCE prefilter (day granularity); real freshness is
# enforced by EMAIL_MAX_AGE_HOURS below.
EMAIL_LOOKBACK_DAYS=2
EMAIL_MAX_MESSAGES=3
# Only messages younger than this are ingested; a run with no fresh issue
# skips the email signal entirely instead of re-shipping an old issue. 20h
# keeps the ~2:30am ET issue fresh all day but excludes yesterday's.
EMAIL_MAX_AGE_HOURS=20
# Cache TTL for the email entry (overrides the 6h signal-cache TTL). The
# issue lands ~2:30am ET and the post-close cron runs after, so each run
# re-reads the mailbox while stores within a run share one fetch. 0 disables
# caching entirely (one IMAP login per store — not recommended).
EMAIL_CACHE_TTL_SECONDS=900
# Plain-text body ceiling (chars) handed to the analyst. Generous on purpose:
# a real issue measured ~85K chars of stripped text, and the analyst runs once
# per signal-cache TTL, so this only guards against a pathological message.
# Truncation is logged (email_body_truncated) when it actually bites.
EMAIL_BODY_MAX_CHARS=100000
# LLM email analyst: one Haiku call per signal-cache TTL extracts the
# demand-relevant items (impact, categories, product keywords, citable key,
# one-line note) from the email bodies and tags them into the news channel.
# Fail-soft; when disabled the subject lines still reach the prompt as soft
# context without keys or categories.
EMAIL_LLM_ENABLED=true
EMAIL_LLM_MODEL=claude-haiku-4-5
# Output budget for the extraction call (3 items + notes ~ 500 tokens; a
# truncated response loses the whole tool input, logged as
# email_analysis_truncated — keep headroom).
EMAIL_LLM_MAX_TOKENS=2048

EVENT_RADIUS_MILES=5
SIGNAL_LOOKAHEAD_DAYS=7
HOLIDAY_LOOKAHEAD_DAYS=21
# A home game is "local" when the team's metro is within this many miles of
# the store (falls back to venue-state match when the store has no geo).
SPORTS_LOCAL_RADIUS_MILES=40

# =====================================================================
# StoreAgent module (mounted at /storeagent). Self-contained: it reads
# the read-only `syncgo` warehouse DIRECTLY over psycopg, independent of
# the Node API the rest of this service uses. Leave blank to keep the
# /storeagent routes dormant; the Botella endpoints above are unaffected.
# =====================================================================

# Read-only source warehouse (syncgo). Required for any /storeagent call.
PGHOST=
PGPORT=5432
PGDATABASE=syncgo
PGUSER=
PGPASSWORD=
PGSSLMODE=require

STOREAGENT_DEBUG_SQL=false

# StoreAgent's own writable Postgres (only used by opt-in run persistence;
# the read-only capability endpoints do not require it).
APP_PGHOST=localhost
APP_PGPORT=5432
APP_PGDATABASE=storeagent
APP_PGUSER=postgres
APP_PGPASSWORD=
APP_PGADMIN_DB=postgres

# StoreAgent narration reuses ANTHROPIC_API_KEY above. Optionally override the
# model / endpoint for it independently of the recommender's LLM settings.
#NARRATION_MODEL=claude-sonnet-4-6
#ANTHROPIC_AUTH_TOKEN=
#ANTHROPIC_BASE_URL=https://api.anthropic.com

# To let the BottleAI browser frontend call /storeagent cross-origin, enable
# CORS by setting the origin(s) of that app, e.g.:
#CORS_ALLOW_ORIGINS=["http://localhost:3001"]

# =====================================================================
# Settings declared in app/config.py that this file did not list until the
# 19 October 2026 QA audit (defect 15). Every one is read from the
# environment by pydantic-settings (case-insensitive); the value shown is
# the default in app/config.py, so leaving a line commented changes nothing.
# The comment above each field in app/config.py says WHY it is what it is;
# this is the inventory, not the argument. JSON-list settings take a JSON
# list, as the examples above do.
# =====================================================================

# ----- Service --------------------------------------------------------------
# APP_NAME=contextual-intelligence-service

# ----- Engine ---------------------------------------------------------------
# True: app/pipeline chooses deterministically and the model only writes
# prose. False is the superseded LLM-chooses arm (24.2% on the backtest),
# kept for comparison on one store, never as a fallback.
# USE_DETERMINISTIC_ENGINE=true
# The trend-validation read fans out to ~25 peer stores on Node's warehouse
# and gets its own, more patient per-request timeout.
# TREND_VALIDATION_TIMEOUT_SECONDS=45
# Per-SKU weekly rates and reorder quantities from the storeagent demand
# engine (direct warehouse read), so cards quote the Buying tab's figures.
# Degrades softly to the Node-feed math when the warehouse is unreachable.
# CANONICAL_DEMAND_ENABLED=true
# Store-intelligence grounding (don't-buy list, lost sales, velocity classes,
# assortment gaps) on the same bridge and the same soft-fail rule.
# STORE_INTEL_ENABLED=true
# MARKET_GAP_MAX_LINES=6
# MARKET_GAP_RECS_MAX=1
# SOCIAL_SIGNALS_MAX=4
# REGISTER_TREND_RECS_MAX=1
# TRENDING_MIN_RECOMMENDATIONS=2
# TRENDING_MAX_RECOMMENDATIONS=4
# When a product's category is empty or junk, infer it from the name.
# CATEGORY_NAME_FALLBACK=true

# ----- LLM ------------------------------------------------------------------
# Declared and NOT sent: anthropic 1.3.x removed temperature from stream()
# and create(). Kept so the decision is findable; tests/test_llm_client.py
# fails the day the SDK restores it.
# LLM_TEMPERATURE=0.0
# A dated model snapshot to pin to. Empty sends the alias in LLM_MODEL and
# records what the API resolved it to - honest, not reproducible.
# LLM_MODEL_PINNED=

# ----- Action-tag policy (enforced deterministically in the validator) -----
# COLD_BOX_MAX_PER_RUN=1
# COLD_BOX_DRIVER_DAYS=3
# ENDCAP_MAX_PER_RUN=2

# ----- Geocoding ------------------------------------------------------------
# CENSUS_GEOCODER_URL=https://geocoding.geo.census.gov/geocoder/locations/onelineaddress

# ----- Social discovery: Twitter/X via an Apify pay-per-result actor -------
# Dormant until APIFY_TOKEN is set. One synchronous actor run per cache TTL
# covers every query; ~100 tweets a day is about two cents inside Apify's
# free monthly credit, which does not roll over and hard-stops when spent
# (the fetcher fail-softs through that).
# APIFY_TOKEN=
# TWITTER_APIFY_ACTOR=kaitoeasyapi~twitter-x-data-tweet-scraper-pay-per-result-cheapest
# TWITTER_QUERIES=["(cocktail OR margarita OR mocktail OR \"espresso martini\" OR negroni)", "(tequila OR whiskey OR bourbon OR seltzer OR sangria)"]
# TWITTER_MIN_LIKES=500
# TWITTER_MAX_POSTS=40
# TWITTER_MAX_ITEMS=100

# ----- Trend floors (the merged Reddit / YouTube / Twitter channel) ---------
# A kept term needs this many supporting posts, OR one supporter above the
# solo bar (normalised engagement units: upvotes, or views/200).
# TREND_MIN_MENTIONS=2
# TREND_SOLO_MIN_SCORE=2500

# ----- Google Trends discovery (rides GOOGLE_TRENDS_ENABLED, off above) ----
# GOOGLE_TRENDS_DISCOVERY_SEEDS=["cocktail", "cocktail recipe", "trending drink"]
# GOOGLE_TRENDS_RISING_MIN_GROWTH=200
# GOOGLE_TRENDS_RISING_MAX=10

# ----- Instagram hashtag velocity, served by OUR Node backend (contract §1.8)
# First-party and fail-soft (the endpoint returns [] until Node's poller has
# baselines - and Node's poller is disabled wherever IG_* is unset), so it
# ships ON unlike Google Trends.
# INSTAGRAM_TRENDS_ENABLED=true
# INSTAGRAM_MIN_ACCELERATION=1.5
# INSTAGRAM_MIN_BASELINE_POINTS=2
# INSTAGRAM_MAX_KEPT=5

# ----- Register-measured trends (contract §1.9): purchases at same-state peer
# registers, mined by Node. The strongest trend evidence tier, and rationed
# so one metric measured many times cannot fill the whole signal strip.
# REGISTER_TRENDS_ENABLED=true
# REGISTER_TRENDS_MAX=6
# REGISTER_SIGNALS_MAX=1

# ----- Sports --------------------------------------------------------------
# SPORTS_LEAGUES=["nfl", "nba", "mlb", "nhl"]
# Within this distance the STADIUM itself drives foot traffic; beyond it the
# pitch is watch-party staples (see SPORTS_LOCAL_RADIUS_MILES above).
# SPORTS_STADIUM_RADIUS_MILES=10
