# Botella frontend - environment template.
#
#   cp frontend/.env.example frontend/.env
#
# Nothing here is secret - CRA bakes every REACT_APP_* value into the public
# bundle at build time, so never put a key in this file. It is gitignored only
# because it sits beside the backend's .env under the same rule.

# NO NOTES ON THE VALUE LINE. Everything after the "=" is the value - dotenv
# only strips a trailing comment introduced by " #". Writing
#     REACT_APP_API_URL=/api (for staging and prod)
# makes every request go to /api(for%20staging%20and%20prod)/... and 404, and
# the browser blames a missing route rather than this file. Comments go on their
# own line, and CRA reads this file ONCE at startup - restart the dev server
# after editing it.
#
# Same-origin API base: the app calls "/api/..." and the CRA dev server proxies
# it to the backend on localhost:3000 (see "proxy" in package.json). One tunnel
# then serves the whole app - no CORS, no second public URL. To point at an
# absolute backend instead, give the full URL ending in /api.
REACT_APP_API_URL=/api

# Which environment this BUILD is for: qa | staging | production.
# qa and staging unlock the internal tools - the per-figure "show the query"
# control and the Generate Insights button. Anything else (including unset)
# means production, which ships neither and does not even compile the warehouse
# queries into the bundle. Local development runs as staging.
REACT_APP_ENV=staging

# Let the dev server answer any Host header - needed when the app is reached
# through a tunnel (cloudflared / ngrok) rather than localhost, otherwise it
# returns "Invalid Host header".
DANGEROUSLY_DISABLE_HOST_CHECK=true

# Hot-reload websocket: infer host/port from the page so it works over a tunnel
# instead of trying to reach localhost:3001 from a remote browser.
WDS_SOCKET_PORT=0

# Tenants the product is being DEMONSTRATED on, comma separated.
#
# Internal builds (REACT_APP_ENV=qa|staging) carry a "Generate Insights" bar
# with an env badge and the caption "Testers only; not shown to stores". That is
# correct for a tester and wrong in front of a prospect, so list the demo
# tenant's client id here for the build you are demoing from.
#
# UNSET = no demo tenants = the bar is visible to testers. A production build
# never shows it whatever this says.
REACT_APP_DEMO_CLIENT_IDS=

# Card Statement Analysis screen (sidebar item, route and screen): true | false.
#
# UNSET = follow the build: shown in qa and staging builds and in `npm start`,
# hidden in a production build until the rollout. true (or 1) shows it in any
# build, false (or 0) hides it in any build; any other value means "follow the
# build", so a typo can never switch it on in production. CRA bakes it in at
# build time: a Docker image takes it as a build arg (frontend/Dockerfile declares
# it, and .gitlab-ci.yml passes the SHOW_CARD_STATEMENTS CI/CD variable through,
# empty when unset). It hides the screen only - the /api/card-statements API
# answers any signed-in session either way. See CARD-STATEMENTS.md §8.1, §10.3.
REACT_APP_SHOW_CARD_STATEMENTS=

# Rename the store for a demo. When set, every surface that names the store
# (greeting, sidebar, titles - utils/storeIdentity.displayStoreName) shows this
# instead of the real business name; the figures underneath are unchanged.
# Empty keeps the real name. Baked in at build time like the flags above:
# the root docker-compose.yml (the QA box) defaults it to "Demo Store",
# production never sets it.
REACT_APP_DEMO_STORE_NAME=
