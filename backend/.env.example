# Botella API - environment template.
#
#   cp backend/.env.example backend/.env    then fill in the values below.
#
# The real backend/.env is NOT in git and must never be: it holds the warehouse
# password, the JWT signing secret and three vendor API keys. Anyone with that
# file can read every tenant's sales data and mint a token for any store. This
# template exists so a fresh clone can at least see WHICH variables are needed -
# without it there was no way to find out short of reading the source.
#
# Ask whoever runs the infrastructure for the real values; they are also in the
# CI variable BACKEND_ENV_B64 (Settings -> CI/CD -> Variables), base64 of the
# production file.

# ── POS warehouse (syncgo). READ-ONLY mirror of the POS. ────────────────────
# Every query filters on BOTH client_id and location_id - this database holds
# every tenant's data in shared tables.
PG_HOST=
PG_PORT=5432
PG_DATABASE=syncgo
PG_USER=
PG_PASSWORD=

# ── Analytics database (bottleai_analytics). Ours: recommendations, chat, ───
#    the StoreAgent result cache, purchase orders, card statements.
#
# NOTE: the code reads the ANALYTICS_PG_* variables. ANALYTICS_DATABASE_URL is
# read by some tooling but NOT by the running server - if you set only the URL,
# the server will quietly connect somewhere else. Set the PG_* ones.
ANALYTICS_DATABASE_URL=
ANALYTICS_PG_HOST=localhost
ANALYTICS_PG_PORT=5432
ANALYTICS_PG_DATABASE=bottleai_analytics
ANALYTICS_PG_USER=
ANALYTICS_PG_PASSWORD=

# ── Auth ────────────────────────────────────────────────────────────────────
# Any long random string in development; a real secret in production. Changing
# it invalidates every issued token.
JWT_SECRET=
PORT=3000

# Shared secret for the machine-to-machine integration routes
# (/api/clients/*, /api/ingestion/*), which the Python recommendation service
# calls. REQUIRED IN PRODUCTION - the server refuses to start without it.
#
# Those routes tenant-scope by PATH PARAMETER, not by who is asking, so without
# a token anyone who can reach the port reads any store's sales, inventory and
# signal history, and can PUT signal-effects, calibration-bundle and
# gate-verdict. Publishing a calibration bundle sets the confidence figure every
# card in the estate displays.
#
# Outside production an empty value leaves the routes reachable from LOOPBACK
# ONLY, which keeps the three-terminal dev flow working. A containerised stack
# reaches Node through the bridge gateway, which is not loopback, so set this
# there.
#
# Generate:  openssl rand -hex 32
# THE SAME VALUE must be set as NODE_API_TOKEN in Botella_External_APIs/.env -
# that is the client which sends the header.
NODE_API_TOKEN=

# ── Model providers ─────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── The Python service (botella_external_apis) ──────────────────────────────
# Two mounts on the same service. REC_SERVICE_URL is not listed in the running
# .env at all, so it falls back to http://127.0.0.1:8000 - set it explicitly if
# the service runs anywhere else, or if something else has taken that port.
# Start the service with:  uvicorn app.main:app --reload --port 8000
REC_SERVICE_URL=http://127.0.0.1:8000
REC_SERVICE_API_KEY=
STOREAGENT_API_URL=http://localhost:8000/storeagent
# Must match SERVICE_API_KEY in the Python service's own .env.
STOREAGENT_API_KEY=

# ── Gmail (recommendation digest email). Optional in development. ───────────
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=

# ── Escape hatch: allow run_sql when row-level security is not active. ──────
# Development only.
BOTELLA_ALLOW_RUNSQL_WITHOUT_RLS=false

# ── What may be hidden from the owner ───────────────────────────────────────
# REC_MIN_PROFIT_USD        hide a card whose expected profit is below this
#                           (default 1; set 0 to hide nothing for being small)
# REC_MIN_CONFIDENCE        hide a card below this confidence - ONLY when the
#                           card's confidence_basis is 'isotonic', a calibrated
#                           curve that differs between cards. On a raw ranking
#                           score, a constant, a flat slate, an evidence count,
#                           a model's guess or an unrecorded basis the floor is
#                           skipped and the card carries
#                           admission_notes: confidence_floor_not_applicable:<basis>
#                           (default 0.35; set 0 to hide nothing for being uncertain)
# REC_REQUIRE_PROFIT_FIGURE hide a profit-claiming card whose money cannot be
#                           computed at all - usually because the POS sends no
#                           cost (default true; false shows it with NO money
#                           line, which is different from showing a fake one)
#
# None of these can make a figure appear that the data does not support.
REC_MIN_PROFIT_USD=1
REC_MIN_CONFIDENCE=0.35
REC_REQUIRE_PROFIT_FIGURE=true

# ── The pilot scoreboards (scripts/pilot-scoreboard.js, migration 036) ──────
# PILOT_SCOREBOARD_CRON_SCHEDULE  when the month that just closed is built;
#                                 default "30 7 1 * *" - the 1st at 07:30,
#                                 after the 05:00 evaluation and the 06:00 gate
# PILOT_SCOREBOARD_LOCATIONS      "client:location,..." - the stores on the
#                                 board; default the five pilot stores named in
#                                 the script. ALL is refused: the report is for
#                                 the five GOOD stores, not the estate.
# PILOT_SCOREBOARD_CRON_SCHEDULE=30 7 1 * *
# PILOT_SCOREBOARD_LOCATIONS=171:171,176:176,177:177,178:178,181:181

# ── Card Statement Analysis (CARD-STATEMENTS.md). All optional. ─────────────
# CS_PARSE_MODEL       model that reads a statement PDF; falls back to
#                      PO_PARSE_MODEL, then to the built-in default
# CS_PARSE_MAX_TOKENS  output budget for one read (streamed, so above 21,333 is fine)
# CS_PARSE_TIMEOUT_MS  deadline for one whole read, body and retry included
#                      (one retry at most, inside the same deadline)
# CS_UPLOAD_DIR        where originals are kept, relative to backend/ unless
#                      absolute. Never under data/imagegen (served without auth).
#                      Must be persistent storage: in the container the default
#                      is /app/data/card-statements, on the backend_data volume.
# CS_STALE_MINUTES     a statement still 'analysing' after this long is marked
#                      failed as interrupted. A value below the read
#                      deadline plus 2 minutes is raised to that, with a warning.
CS_PARSE_MODEL=
CS_PARSE_MAX_TOKENS=32000
CS_PARSE_TIMEOUT_MS=240000
CS_UPLOAD_DIR=data/card-statements
CS_STALE_MINUTES=10
# Whether a refund gives the Rebelipay fee back is a rule, not a setting here:
# rebelipay.refundsReturnFee in services/cardStatementRules.js (default true).
# Where "Switch to Rebelipay" sends the owner (http or https only).
REBELIPAY_CTA_URL=https://rebelipay.com
# When set, each click is also POSTed here as JSON (5 s timeout; a failure is
# logged and never shown to the owner). Empty means log the event only.
REBELIPAY_LEAD_WEBHOOK=

# ════════════════════════════════════════════════════════════════════════════
# Everything below is READ BY THE CODE and was not in this file until the
# 19 October 2026 QA audit (defect 15: "~20 env vars undocumented"). Found by
# grepping process.env.* across server.js, services/, scripts/, lib/, routes/,
# middleware/ and database/; the default printed is the one in the code, and
# every line is commented out because the default is what you get by saying
# nothing. The file:line is given so the claim can be checked.
# ════════════════════════════════════════════════════════════════════════════

# ── Runtime ─────────────────────────────────────────────────────────────────
# NODE_ENV           "production" turns ON the fail-closed startup checks in
#                    middleware/auth.js (NODE_API_TOKEN and JWT_SECRET must be
#                    set) and turns OFF boot-time migrations unless
#                    MIGRATE_ON_BOOT says otherwise. Anything else is development.
# LOG_LEVEL          winston level (utils/logger.js); default info
# MIGRATE_ON_BOOT    run database/migrate.js analytics at startup (server.js
#                    ~242). Empty = "yes, unless NODE_ENV=production";
#                    "true"/"1" forces it on in production too; anything else
#                    turns it off. A failure is logged and is NOT fatal.
# TZ                 not read by our code - read by Node itself. node-cron
#                    fires every schedule below in the PROCESS timezone, and
#                    only one cron names its own (the forward test:
#                    { timezone: 'Asia/Kolkata' }, server.js ~1290). So the
#                    "04:00 batch" is 04:00 wherever the box thinks it is.
#                    Set TZ on the box to the zone the times are written for.
# FRONTEND_URL       where the Gmail OAuth callback sends the browser back;
#                    default http://localhost:3001 (server.js ~84)
# PUBLIC_SERVER_URL  the URL the browser can reach this server at, used to
#                    build generated-image links (routes/imagegen.js); falls
#                    back to FRONTEND_URL, then http://localhost:$PORT
# SELF_BASE_URL      how the nightly Python scripts (calibration refit, signal
#                    fit) call BACK into this server's /api/clients routes;
#                    default http://localhost:3000 (server.js ~1074, ~1166).
#                    Must follow PORT - the local 3010 override sets it.
# INTEGRATION_TOKEN  the bearer those scripts send on that call (--token).
#                    Must equal NODE_API_TOKEN once that is set, or the 07:00
#                    refit gets 401s from a correctly configured server.
# EVAL_PORT          overrides PORT for an evaluation-harness server (server.js:23)
# BOTELLA_EVAL_MODE  "1"/"true": chat runs in evaluation mode (routes/chat.js:67)
# BOTELLA_READ_ONLY_DB    "true": every syncgo session is read-only at the
#                    Postgres level (database/connection.js) - recommended in
#                    production until a read-only role exists
# BOTELLA_DISABLE_RUN_SQL "true": the run_sql chat tool is off entirely
# PYTHON_BIN, PYTHON_SCRIPTS_DIR  interpreter and scripts directory for
#                    lib/pythonRunner.js. The image sets both; a checkout
#                    autodetects ../Botella_External_APIs/scripts.
# NODE_ENV=
# LOG_LEVEL=info
# MIGRATE_ON_BOOT=
# TZ=
# FRONTEND_URL=http://localhost:3001
# PUBLIC_SERVER_URL=
# SELF_BASE_URL=http://localhost:3000
# INTEGRATION_TOKEN=
# BOTELLA_READ_ONLY_DB=false
# BOTELLA_DISABLE_RUN_SQL=false
# PYTHON_BIN=
# PYTHON_SCRIPTS_DIR=

# ── Migrations (database/migrate.js) ────────────────────────────────────────
# ANALYTICS_MIGRATE_DSN  owner/admin connection string used INSTEAD of the
#                    ANALYTICS_PG_* app role, for environments where the app
#                    role has no CREATE (prod/staging). Empty = app role.
# SYNCGO_MIGRATE_DSN REQUIRED for `npm run migrate:syncgo`; there is no
#                    fallback, because the app's syncgo role is SELECT-only.
# ANALYTICS_MIGRATE_DSN=
# SYNCGO_MIGRATE_DSN=

# ── Nightly jobs: the schedules (five-field cron, PROCESS timezone - see TZ) ─
# The defaults below are the published chain, in the order it runs. Moving one
# means moving what depends on it: evaluation after generation, the gates
# after evaluation, the refit after the gates.
# INGEST_DIGEST_SCHEDULE=0 3 * * *          sync-state refresh + connector digest
# LEAD_TIME_CRON_SCHEDULE=10 3 * * *        per-vendor lead times from receipts
# STOREINTEL_CRON_SCHEDULE=30 3 * * *       StoreAgent cache warm
# ON_HAND_CRON_SCHEDULE=45 3 * * *          shelf count per SKU
# QUALITY_CRON_SCHEDULE=50 3 * * *          sheet 02 quality gates
# REC_CRON_SCHEDULE=0 4 * * *               the recommendation batch
# FORWARD_TEST_CRON_SCHEDULE=15 4 * * *     forward test (Asia/Kolkata, the one named zone)
# REC_EVAL_CRON_SCHEDULE=0 5 * * *          evaluation + holdout report
# REC_DIGEST_CRON_SCHEDULE=30 5 * * 1       weekly owner digest, Monday
# GATE_CRON_SCHEDULE=0 6 * * *              family gate
# DRIFT_CRON_SCHEDULE=30 6 * * *            drift monitor
# CALIB_CRON_SCHEDULE=0 7 * * *             calibration refit (publish_calibration.py --pooled)
# PILOT_SCOREBOARD_CRON_SCHEDULE=30 7 1 * * monthly boards (documented above)
# SIGNAL_FIT_SCHEDULE=0 8 * * 0             weekly signal-effect fit, Sunday
# IG_TOKEN_CRON_SCHEDULE=0 2 * * 1          Instagram token refresh, Monday
# IG_TOKEN_WATCHDOG_SCHEDULE=10 2 * * *     Instagram token watchdog
# IG_TRENDS_CRON_SCHEDULE=30 2 * * *        Instagram hashtag poll

# ── The recommendation batch (server.js ~300-330) ───────────────────────────
# REC_CRON_LOCATIONS   "client:location,..." or ALL (default: every store with
#                      a sync). ALSO scopes the calibration refit and the
#                      signal fit, and is the default for STOREINTEL_CRON_LOCATIONS.
# REC_CRON_CONCURRENCY stores in flight at once; default 5
# REC_SERVICE_TIMEOUT_MS  one store's call to the Python service; default 180000
# REC_HOLDOUT_PCT      percent of a run's cards withheld as the holdout arm
#                      (services/recommendationService.js ~283). Default 10,
#                      clamped to 0..50; 0 turns the experiment off "at the
#                      price of never knowing".
# REC_GATE_ENFORCED    "true" lets the store/family gate WITHHOLD cards.
#                      Default false: the gate is computed and shown, not
#                      enforced (services/familyGateService.js ~49). Read the
#                      production block at the end before flipping it.
# REC_MAX_STALENESS_MULTIPLE  admission: a store whose last sync is older than
#                      this many times its own cadence is refused; default 6
#                      (services/recommendationGateService.js)
# REC_MIN_STALENESS_DAYS  floor on that allowance, in days; default 1
# REC_INTERNAL_API_KEY key for the internal regenerate endpoint in
#                      routes/recommendations.js; empty disables it
# REC_FEED_INCLUDE_MINIS  "true" keeps small formats in the integration feed
#                      (services/integrationService.js); default false
# REC_FEED_MINI_ML_MAX the ml ceiling that defines a mini there; default 100
# REC_CRON_LOCATIONS=ALL
# REC_CRON_CONCURRENCY=5
# REC_SERVICE_TIMEOUT_MS=180000
# REC_HOLDOUT_PCT=10
# REC_GATE_ENFORCED=false
# REC_MAX_STALENESS_MULTIPLE=6
# REC_MIN_STALENESS_DAYS=1
# REC_INTERNAL_API_KEY=
# REC_FEED_INCLUDE_MINIS=false
# REC_FEED_MINI_ML_MAX=100

# ── StoreAgent warm job and cache (server.js ~902, services/storeIntelligenceService.js) ──
# STOREINTEL_CRON_LOCATIONS=<REC_CRON_LOCATIONS>   which stores to pre-warm
# STOREINTEL_CRON_CONCURRENCY=3
# STOREINTEL_CRON_NARRATION=false      ask StoreAgent for narration too (LLM cost)
# STOREINTEL_CAPABILITIES=             comma list; empty = the service's default set
# STOREINTEL_TIMEOUT_MS=90000          one capability call
# STOREINTEL_LOGIN_REFRESH=true        refresh a store's intel when its owner logs in
# STOREINTEL_LOGIN_REFRESH_DELAY_MS=25000
# STOREAGENT_CACHE_MAX_AGE_HOURS=24    how old a cached answer may be before
#                                      /api/storeagent refreshes it (routes/storeagent.js)

# ── Evaluation, holdout, gates, drift, calibration ───────────────────────────
# REC_EVAL_WINDOWS=7,30,60,90        scoring windows in days (services/recommendationEvalService.js)
# REC_EVAL_LOOKBACK_DAYS=180         how far back the evaluator looks
# REC_EVAL_WINNER_MIN=0.6            a card at or above this lift is a winner
# REC_EVAL_UNDERPERFORMER_MAX=0.4    at or below this, an underperformer
# HOLDOUT_MIN_PER_ARM=5              measured outcomes each arm needs before the
#                                    holdout report states a difference
# CALIB_WINDOW_DAYS=30               outcomes window for the calibration refit
# LEAD_TIME_DEFAULT_DAYS=7           supplier lead time when none is measured
# LEAD_TIME_MIN_OBSERVATIONS=3       receipts before a vendor's own figure is used
# ON_HAND_STALE_AFTER_DAYS=7         a shelf count older than this is stale (server.js ~529)
# PO_EVAL_WINDOWS=30,60,90           purchase-order effectiveness windows

# ── Ingestion / sync state (services/ingestionService.js, featureStoreService.js) ──
# SYNC_STALE_AFTER_DAYS=2            a store with no sync for this long is stale
# SYNC_DEAD_AFTER=5                  consecutive failures before a connector is dead
# SYNC_MAX_RETRIES=3                 transient attempts per sync
# SYNC_BACKOFF_BASE_MS=1000
# SYNC_CONCURRENCY=5
# FEATURE_LOOKBACK_DAYS=7            incremental feature-store window
# FEATURE_OUTAGE_RUN_DAYS=5          a gap this long is an outage, backfilled in chunks
# FEATURE_CHUNK_DAYS=365
# FEATURE_BACKFILL_TIMEOUT=600s      Postgres statement_timeout for one backfill chunk

# ── Forward test (scripts/forward-test-daily.js, migration 038) ─────────────
# FORWARD_TEST_LOCATIONS       "client:location,...", bare client ids, or ALL (default)
# FORWARD_TEST_PERIOD_START / FORWARD_TEST_PERIOD_END   the window; defaults in the script
# FORWARD_TEST_FINAL_DATE      the morning the final report is built (server.js ~1261)
# FORWARD_TEST_STORE_TIMEOUT_MS    one store's generate call; default 300000
# FORWARD_TEST_GENERATE_BUDGET_MS  whole-run budget for generation; default 2700000 (45 min)
# FORWARD_TEST_LOCATIONS=ALL
# FORWARD_TEST_FINAL_DATE=2026-10-30
# FORWARD_TEST_STORE_TIMEOUT_MS=300000
# FORWARD_TEST_GENERATE_BUDGET_MS=2700000

# ── Signal-effect fit (server.js ~1109-1170, publish_signal_effects.py) ─────
# SIGNAL_FIT_DATA   directory the per-store sales export is written to before
#                   the fit reads it; default under backend/data
# SIGNAL_FIT_DATA=

# ── Purchase orders / invoice parsing (services/purchaseOrderService.js) ────
# PO_PARSE_MODEL=claude-sonnet-5     also the fallback for CS_PARSE_MODEL above
# PO_PARSE_MAX_TOKENS=32000
# PO_UPLOAD_DIR=                     where uploaded invoices are kept; same
#                                    persistence rule as CS_UPLOAD_DIR

# ── Lead-capture email (routes/leads.js). Without all three of HOST, USER and
#    PASS the lead is logged and NOT mailed; the server starts either way. ───
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=                         a 16-character Gmail App Password, not the account password
# NOTIFICATION_EMAIL=                comma-separated recipients; default info@botella.ai

# ── Instagram trends (services/instagramTrendsService.js, server.js ~1374) ──
# All four of IG_USER_ID, IG_ACCESS_TOKEN, META_APP_ID and META_APP_SECRET are
# needed, or the three IG crons log "Disabled" at boot and do nothing - which
# is the state of every environment today.
# IG_USER_ID=
# IG_ACCESS_TOKEN=
# META_APP_ID=
# META_APP_SECRET=
# IG_TREND_HASHTAGS=                 comma list; empty = the built-in drink vocabulary

# ── scripts/verify-metric-sql.js (manual) ───────────────────────────────────
# VERIFY_API_BASE=http://127.0.0.1:3000
# VERIFY_STALE_HOURS=6
# VERIFY_TOKEN=                      a user JWT for the authenticated metric routes

# ════════════════════════════════════════════════════════════════════════════
# PRODUCTION: the three-store deployment
#
#   171:171  Bethany Discount Liquor
#   173:173  Tuscany Wine, Spirits + Craft
#   188:188  Grapes and Grains Liquor
#
# client_id == location_id for all three, like the five pilot stores before
# them. Everything here is an OVERRIDE of a default documented above; nothing
# in the code changes for these stores.
# ════════════════════════════════════════════════════════════════════════════
# NODE_ENV=production
#
# node-cron fires in the process timezone and only the forward-test cron names
# one (Asia/Kolkata). Run the box in the stores' zone so "04:00" is 04:00
# there, or every schedule above is wrong by the UTC offset of wherever the
# box happens to be. Bethany is in Allen, TX; confirm 173 and 188 before
# choosing. TZ is read by Node itself, not by this code.
# TZ=America/Chicago
#
# The batch, the calibration refit, the signal fit and the StoreAgent warm all
# scope by this one list (the last through STOREINTEL_CRON_LOCATIONS's default).
# REC_CRON_LOCATIONS=171:171,173:173,188:188
#
# Same three stores on the forward test and the monthly boards.
# PILOT_SCOREBOARD_LOCATIONS overrides PILOT_STORES in
# scripts/pilot-scoreboard.js (left as the original five on purpose: that
# constant is the audit's record of which stores were gated, and the script
# labels any store outside it `pilot_store: false` in its JSON and "(not a
# pilot store)" in the summary line, so a board for 173 or 188 says what kind
# of board it is).
# FORWARD_TEST_LOCATIONS=171:171,173:173,188:188
# PILOT_SCOREBOARD_LOCATIONS=171:171,173:173,188:188
#
# The holdout stays on at its default: one card in ten withheld, so the other
# nine can be shown to do something. 0 switches it off.
# REC_HOLDOUT_PCT=10
#
# LEAVE THE GATE UNENFORCED until two things are true: the store-gate verdicts
# for these three stores have been republished for a RECENT month WITH a
# valid_until (migration 033 added the column; every verdict in the table
# today was measured for March and carries none, so all of them read as
# expired under the 120-day rule), and the family gate has at least one
# store-family pair live (today: 37 pairs, all shadow). Turning it on before
# that withholds every card at every store, which is not caution, it is an
# outage. Checklist in the gate's own header: services/familyGateService.js.
# REC_GATE_ENFORCED=false
#
# Required in production, by the server's own startup check (middleware/auth.js):
# JWT_SECRET, NODE_API_TOKEN. Set INTEGRATION_TOKEN to the same value as
# NODE_API_TOKEN, and REC_SERVICE_URL / STOREAGENT_API_URL / SELF_BASE_URL to
# where the services actually are (the compose file sets the first two).
